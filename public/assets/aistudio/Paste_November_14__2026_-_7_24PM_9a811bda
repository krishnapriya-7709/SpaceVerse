<!DOCTYPE html>
<html lang="en">

<head>
   <meta charset="utf-8">
   <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
   <title>SPACEVERSE: GALAXY-X Space Research Facility</title>
   <style>
      :root {
         color-scheme: dark;
         --accent: #4fe3d4;
         --accent-rgb: 79, 227, 212;
         --gold: #f2c14e;
         --gold-rgb: 242, 193, 78;
         --blue: #38bdf8;
         --dark-bg: rgba(6, 14, 28, 0.88);
         --card-border: rgba(255, 255, 255, 0.15);
         --navy-deep: #050e20;
      }

      html,
      body {
         margin: 0;
         height: 100%;
         overflow: hidden;
         background: #020611;
         color: #e8eefc;
         font: 14px/1.4 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
         -webkit-user-select: none;
         user-select: none;
         touch-action: none;
      }

      canvas.webgl {
         position: fixed;
         inset: 0;
         width: 100%;
         height: 100%;
         display: block;
      }

      .hud {
         position: fixed;
         z-index: 3;
         pointer-events: none;
         text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
      }

      .box {
         background: var(--dark-bg);
         border: 1px solid var(--card-border);
         border-radius: 12px;
         padding: 10px 14px;
         backdrop-filter: blur(8px);
         box-shadow: 0 4px 20px rgba(0, 0, 0, 0.45);
      }

      /* ========================================================
         1. SPACEVERSE OPENING TITLE SCREEN
         ======================================================== */
      #spaceverse-intro {
         position: fixed;
         inset: 0;
         z-index: 150;
         display: flex;
         flex-direction: column;
         align-items: center;
         justify-content: center;
         background: radial-gradient(circle at 50% 50%, rgba(6, 18, 42, 0.65) 0%, rgba(2, 6, 16, 0.9) 100%);
         backdrop-filter: blur(4px);
         transition: opacity 0.85s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.85s;
         pointer-events: auto;
      }

      #spaceverse-intro.fade-out {
         opacity: 0;
         visibility: hidden;
         pointer-events: none;
      }

      .intro-content {
         text-align: center;
         position: relative;
         padding: 20px;
         max-width: 90vw;
      }

      .intro-pretitle {
         font-size: 0.85rem;
         font-weight: 700;
         letter-spacing: 5px;
         text-transform: uppercase;
         color: var(--accent);
         margin-bottom: 12px;
         opacity: 0;
         transform: translateY(-8px);
         animation: introFadeDown 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards 0.2s;
         text-shadow: 0 0 12px rgba(79, 227, 212, 0.6);
      }

      .spaceverse-title {
         font-family: system-ui, -apple-system, sans-serif;
         font-size: clamp(3rem, 9vw, 5.8rem);
         font-weight: 900;
         letter-spacing: clamp(6px, 2vw, 16px);
         text-transform: uppercase;
         margin: 0;
         line-height: 1.05;
         background: linear-gradient(180deg, #ffffff 0%, #cbd5e1 55%, #4fe3d4 100%);
         -webkit-background-clip: text;
         -webkit-text-fill-color: transparent;
         filter: drop-shadow(0 0 25px rgba(79, 227, 212, 0.45)) drop-shadow(0 0 60px rgba(56, 189, 248, 0.3));
         opacity: 0;
         transform: scale(0.92);
         animation: introZoomIn 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards 0.35s;
      }

      .intro-subtitle {
         font-size: clamp(0.78rem, 1.6vw, 1rem);
         font-weight: 600;
         letter-spacing: 4px;
         color: #94a3b8;
         text-transform: uppercase;
         margin-top: 14px;
         opacity: 0;
         transform: translateY(8px);
         animation: introFadeUp 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards 0.6s;
      }

      .intro-loader-line {
         width: 180px;
         height: 2px;
         background: rgba(255, 255, 255, 0.12);
         margin: 28px auto 0;
         border-radius: 2px;
         overflow: hidden;
         position: relative;
      }

      .intro-loader-bar {
         width: 0%;
         height: 100%;
         background: linear-gradient(90deg, #38bdf8, #4fe3d4);
         box-shadow: 0 0 10px #4fe3d4;
         animation: introLoad 2.4s cubic-bezier(0.25, 1, 0.5, 1) forwards 0.4s;
      }

      @keyframes introFadeDown {
         to {
            opacity: 0.9;
            transform: translateY(0);
         }
      }

      @keyframes introZoomIn {
         to {
            opacity: 1;
            transform: scale(1);
         }
      }

      @keyframes introFadeUp {
         to {
            opacity: 0.85;
            transform: translateY(0);
         }
      }

      @keyframes introLoad {
         0% {
            width: 0%;
         }

         60% {
            width: 75%;
         }

         100% {
            width: 100%;
         }
      }

      /* ========================================================
         2. INTERACTIVE WELCOME SEQUENCE OVERLAY
         ======================================================== */
      #welcome-overlay {
         position: fixed;
         inset: 0;
         z-index: 100;
         display: flex;
         align-items: center;
         justify-content: center;
         padding: 20px;
         box-sizing: border-box;
         background: radial-gradient(circle at 50% 50%, rgba(6, 18, 38, 0.35) 0%, rgba(2, 6, 16, 0.78) 100%);
         transition: opacity 0.6s ease-out, visibility 0.6s;
         pointer-events: auto;
      }

      #welcome-overlay.hidden {
         opacity: 0;
         visibility: hidden;
         pointer-events: none;
      }

      .welcome-flow-card {
         max-width: 560px;
         width: 100%;
         background: rgba(6, 16, 36, 0.84);
         border: 1px solid rgba(79, 227, 212, 0.4);
         border-radius: 20px;
         padding: 34px 38px;
         box-shadow: 0 10px 45px rgba(0, 0, 0, 0.8), 0 0 35px rgba(79, 227, 212, 0.15);
         backdrop-filter: blur(14px);
         text-align: center;
         position: relative;
         box-sizing: border-box;
      }

      .step-indicators {
         display: flex;
         justify-content: center;
         gap: 8px;
         margin-bottom: 22px;
      }

      .step-dot {
         width: 32px;
         height: 4px;
         border-radius: 2px;
         background: rgba(255, 255, 255, 0.16);
         transition: background 0.3s, transform 0.3s;
      }

      .step-dot.active {
         background: var(--accent);
         box-shadow: 0 0 8px var(--accent);
      }

      .welcome-tag {
         display: inline-flex;
         align-items: center;
         gap: 8px;
         padding: 4px 14px;
         background: rgba(79, 227, 212, 0.12);
         border: 1px solid rgba(79, 227, 212, 0.4);
         border-radius: 20px;
         font-size: 0.74rem;
         font-weight: 700;
         letter-spacing: 1.5px;
         color: var(--accent);
         text-transform: uppercase;
         margin-bottom: 18px;
      }

      .welcome-msg-stage {
         min-height: 130px;
         display: flex;
         flex-direction: column;
         justify-content: center;
         align-items: center;
         margin-bottom: 26px;
      }

      .welcome-main-text {
         font-size: clamp(1.4rem, 3.2vw, 1.85rem);
         font-weight: 700;
         color: #ffffff;
         letter-spacing: -0.3px;
         line-height: 1.35;
         margin: 0 0 12px;
         text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7);
         min-height: 2.7em;
         display: flex;
         align-items: center;
         justify-content: center;
      }

      .welcome-sub-text {
         font-size: 0.98rem;
         line-height: 1.6;
         color: #c5d4f0;
         margin: 0;
         max-width: 460px;
         min-height: 3.2em;
      }

      .typewriter-caret {
         display: inline-block;
         color: var(--accent);
         font-weight: 300;
         margin-left: 2px;
         animation: blinkCaret 0.75s step-end infinite;
         vertical-align: baseline;
         text-shadow: 0 0 8px var(--accent);
      }

      @keyframes blinkCaret {

         0%,
         100% {
            opacity: 1;
         }

         50% {
            opacity: 0;
         }
      }

      .welcome-action-wrap {
         display: flex;
         justify-content: center;
         align-items: center;
         gap: 14px;
      }

      .btn-flow {
         display: inline-flex;
         align-items: center;
         justify-content: center;
         gap: 8px;
         min-width: 220px;
         font: 700 0.98rem system-ui, sans-serif;
         letter-spacing: 1.2px;
         text-transform: uppercase;
         padding: 15px 30px;
         border-radius: 12px;
         border: 0;
         cursor: pointer;
         transition: transform 0.15s, box-shadow 0.2s, background 0.2s;
      }

      .btn-flow.next {
         background: rgba(14, 30, 60, 0.9);
         border: 1px solid rgba(79, 227, 212, 0.6);
         color: #4fe3d4;
         box-shadow: 0 4px 18px rgba(0, 0, 0, 0.5);
      }

      .btn-flow.next:hover {
         background: rgba(20, 44, 88, 0.95);
         border-color: #4fe3d4;
         transform: translateY(-2px);
         box-shadow: 0 6px 22px rgba(79, 227, 212, 0.3);
      }

      .btn-flow.accept {
         background: linear-gradient(135deg, #4fe3d4 0%, #22c7b5 100%);
         color: #03151c;
         box-shadow: 0 4px 22px rgba(79, 227, 212, 0.45);
         animation: pulseGlow 2s infinite ease-in-out;
      }

      .btn-flow.accept:hover {
         transform: translateY(-2px);
         box-shadow: 0 6px 28px rgba(79, 227, 212, 0.7);
      }

      @keyframes pulseGlow {

         0%,
         100% {
            box-shadow: 0 4px 22px rgba(79, 227, 212, 0.4);
         }

         50% {
            box-shadow: 0 4px 30px rgba(79, 227, 212, 0.75);
         }
      }

      .welcome-hints {
         display: flex;
         justify-content: center;
         flex-wrap: wrap;
         gap: 14px;
         margin-top: 22px;
         padding-top: 18px;
         border-top: 1px solid rgba(255, 255, 255, 0.1);
         font-size: 0.78rem;
         color: #8da1c7;
      }

      .welcome-hints span b {
         color: #c7d6f5;
      }

      /* ========================================================
         INTERACTIVE TUTORIAL SPOTLIGHT & HUD INDICATOR
         ======================================================== */
      .tut-highlight {
         outline: 3px solid #4fe3d4 !important;
         box-shadow: 0 0 25px rgba(79, 227, 212, 0.9) !important;
         animation: pulseTarget 1.1s infinite alternate !important;
         position: relative;
         z-index: 1000 !important;
      }

      @keyframes pulseTarget {
         from {
            transform: scale(1);
            box-shadow: 0 0 15px rgba(79, 227, 212, 0.6);
         }

         to {
            transform: scale(1.04);
            box-shadow: 0 0 32px rgba(79, 227, 212, 1);
         }
      }

      #tut-progress-hud {
         position: fixed;
         top: calc(58px + env(safe-area-inset-top, 0px));
         left: 12px;
         z-index: 15;
         background: rgba(6, 16, 36, 0.94);
         border: 1px solid rgba(79, 227, 212, 0.5);
         border-radius: 12px;
         padding: 10px 14px;
         box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6), 0 0 14px rgba(79, 227, 212, 0.2);
         backdrop-filter: blur(8px);
         max-width: 360px;
         display: none;
         pointer-events: auto;
      }

      .tut-header-row {
         display: flex;
         align-items: center;
         justify-content: space-between;
         gap: 10px;
         margin-bottom: 6px;
      }

      .tut-badge-tag {
         font-size: 0.72rem;
         font-weight: 800;
         letter-spacing: 1px;
         color: var(--accent);
         text-transform: uppercase;
      }

      .tut-prog-txt {
         font-size: 0.76rem;
         font-weight: 700;
         color: #ffd700;
      }

      .tut-bar-track {
         width: 100%;
         height: 5px;
         background: rgba(255, 255, 255, 0.12);
         border-radius: 3px;
         overflow: hidden;
         margin-bottom: 8px;
      }

      .tut-bar-fill {
         height: 100%;
         background: linear-gradient(90deg, #38bdf8, #4fe3d4);
         width: 16%;
         transition: width 0.3s;
      }

      .tut-instruction {
         font-size: 0.85rem;
         font-weight: 600;
         color: #ffffff;
         line-height: 1.35;
      }

      .tut-subhint {
         font-size: 0.74rem;
         color: #94a3b8;
         margin-top: 4px;
      }

      /* Component Explorer Interactive Card in Assembly Hangar */
      .comp-grid {
         display: grid;
         grid-template-columns: 1fr 1fr;
         gap: 10px;
         margin: 16px 0;
      }

      .comp-card {
         background: rgba(14, 26, 52, 0.8);
         border: 1px solid rgba(255, 255, 255, 0.14);
         border-radius: 10px;
         padding: 10px;
         text-align: left;
         cursor: pointer;
         transition: all 0.15s;
      }

      .comp-card:hover {
         background: rgba(20, 40, 80, 0.95);
         border-color: var(--accent);
         transform: translateY(-1px);
      }

      .comp-card.inspected {
         border-color: #34d399;
         background: rgba(10, 45, 40, 0.7);
      }

      .comp-card .c-title {
         font-size: 0.82rem;
         font-weight: 700;
         color: #fff;
         margin-bottom: 3px;
         display: flex;
         align-items: center;
         justify-content: space-between;
      }

      .comp-card .c-desc {
         font-size: 0.72rem;
         color: #cbd5e1;
         line-height: 1.3;
      }

      /* ========================================================
         7. TEN-LEVEL CAMPAIGN SELECTION SCREEN
         ======================================================== */
      #campaign-modal {
         position: fixed;
         inset: 0;
         z-index: 125;
         background: rgba(2, 6, 16, 0.92);
         backdrop-filter: blur(14px);
         display: none;
         place-items: center;
         padding: 20px;
         box-sizing: border-box;
      }

      .campaign-container {
         max-width: 1080px;
         width: 100%;
         max-height: 94vh;
         background: rgba(8, 16, 34, 0.96);
         border: 1px solid rgba(79, 227, 212, 0.45);
         border-radius: 20px;
         box-shadow: 0 0 60px rgba(0, 0, 0, 0.85), 0 0 35px rgba(79, 227, 212, 0.2);
         padding: 24px 30px;
         display: flex;
         flex-direction: column;
         overflow-y: auto;
         box-sizing: border-box;
      }

      .campaign-header {
         display: flex;
         align-items: center;
         justify-content: space-between;
         border-bottom: 1px solid rgba(255, 255, 255, 0.12);
         padding-bottom: 14px;
         margin-bottom: 18px;
      }

      .campaign-header h2 {
         margin: 0;
         font-size: 1.4rem;
         color: #fff;
         letter-spacing: 0.5px;
      }

      .campaign-header .sub-txt {
         font-size: 0.8rem;
         color: #94a3b8;
         margin-top: 3px;
      }

      .campaign-grid {
         display: grid;
         grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
         gap: 14px;
         margin-bottom: 18px;
      }

      .camp-card {
         background: rgba(14, 25, 48, 0.7);
         border: 1px solid rgba(255, 255, 255, 0.12);
         border-radius: 12px;
         padding: 12px 14px;
         position: relative;
         display: flex;
         flex-direction: column;
         justify-content: space-between;
         min-height: 140px;
         transition: all 0.2s;
         cursor: pointer;
      }

      .camp-card.locked {
         opacity: 0.45;
         cursor: not-allowed;
         filter: grayscale(0.6);
      }

      .camp-card.available {
         border-color: rgba(79, 227, 212, 0.6);
         box-shadow: 0 0 14px rgba(79, 227, 212, 0.15);
      }

      .camp-card.available:hover {
         transform: translateY(-2px);
         border-color: var(--accent);
         box-shadow: 0 0 20px rgba(79, 227, 212, 0.35);
      }

      .camp-card.completed {
         border-color: rgba(242, 193, 78, 0.6);
         background: rgba(22, 34, 60, 0.85);
      }

      .camp-card .c-lvl-num {
         font-size: 0.7rem;
         font-weight: 800;
         letter-spacing: 1px;
         color: var(--accent);
         text-transform: uppercase;
      }

      .camp-card.completed .c-lvl-num {
         color: var(--gold);
      }

      .camp-card .c-title {
         font-size: 0.88rem;
         font-weight: 700;
         color: #fff;
         margin: 4px 0 6px;
         line-height: 1.25;
      }

      .camp-card .c-target {
         font-size: 0.74rem;
         color: #cbd5e1;
         line-height: 1.3;
      }

      .camp-card .c-status-row {
         margin-top: 10px;
         display: flex;
         align-items: center;
         justify-content: space-between;
         font-size: 0.7rem;
         font-weight: 700;
      }

      /* ========================================================
         LEVEL 1: SATELLITE ASSEMBLY LAB WORKSPACE
         ======================================================== */
      #sat-assembly-lab {
         position: fixed;
         inset: 0;
         z-index: 140;
         background: radial-gradient(circle at 50% 40%, #081735 0%, #030a1c 65%, #01040e 100%);
         display: none;
         flex-direction: column;
         box-sizing: border-box;
      }

      .sat-top-bar {
         display: flex;
         align-items: center;
         justify-content: space-between;
         padding: 12px 24px;
         background: rgba(6, 16, 36, 0.92);
         border-bottom: 1px solid rgba(79, 227, 212, 0.35);
         backdrop-filter: blur(10px);
      }

      .sat-title-box {
         display: flex;
         align-items: center;
         gap: 12px;
      }

      .sat-level-badge {
         background: var(--accent);
         color: #03151c;
         font-weight: 800;
         font-size: 0.76rem;
         padding: 3px 10px;
         border-radius: 12px;
         letter-spacing: 1px;
      }

      .sat-title-box h2 {
         margin: 0;
         font-size: 1.25rem;
         color: #fff;
         letter-spacing: 0.5px;
      }

      .sat-prog-box {
         flex: 1;
         max-width: 380px;
         margin: 0 24px;
      }

      .sat-prog-label {
         font-size: 0.74rem;
         font-weight: 700;
         color: var(--accent);
         margin-bottom: 4px;
         display: flex;
         justify-content: space-between;
      }

      .sat-prog-track {
         width: 100%;
         height: 8px;
         background: rgba(255, 255, 255, 0.12);
         border-radius: 4px;
         overflow: hidden;
      }

      .sat-prog-fill {
         height: 100%;
         background: linear-gradient(90deg, #38bdf8, #4fe3d4);
         width: 0%;
         transition: width 0.3s;
      }

      .sat-workspace-body {
         flex: 1;
         display: grid;
         grid-template-columns: 290px 1fr 320px;
         gap: 16px;
         padding: 16px;
         overflow: hidden;
         box-sizing: border-box;
      }

      @media (max-width: 900px) {
         .sat-workspace-body {
            grid-template-columns: 1fr;
            overflow-y: auto;
         }
      }

      .sat-panel-left {
         display: flex;
         flex-direction: column;
         gap: 12px;
         overflow-y: auto;
      }

      .sat-card {
         background: rgba(10, 22, 46, 0.82);
         border: 1px solid rgba(255, 255, 255, 0.12);
         border-radius: 14px;
         padding: 14px;
         backdrop-filter: blur(8px);
      }

      .sat-card-title {
         font-size: 0.78rem;
         font-weight: 800;
         letter-spacing: 1px;
         color: var(--accent);
         text-transform: uppercase;
         margin-bottom: 8px;
      }

      .sat-feedback-box {
         font-size: 0.82rem;
         line-height: 1.45;
         padding: 10px 12px;
         border-radius: 8px;
         min-height: 60px;
         transition: all 0.2s;
      }

      .sat-feedback-neutral {
         background: rgba(255, 255, 255, 0.05);
         border: 1px solid rgba(255, 255, 255, 0.1);
         color: #cbd5e1;
      }

      .sat-feedback-success {
         background: rgba(52, 211, 153, 0.12);
         border: 1px solid #34d399;
         color: #a7f3d0;
      }

      .sat-feedback-error {
         background: rgba(248, 113, 113, 0.12);
         border: 1px solid #f87171;
         color: #fca5a5;
      }

      .sat-checklist-item {
         display: flex;
         align-items: center;
         justify-content: space-between;
         font-size: 0.75rem;
         padding: 6px 8px;
         border-radius: 6px;
         margin-bottom: 4px;
         background: rgba(255, 255, 255, 0.03);
         color: #94a3b8;
      }

      .sat-checklist-item.done {
         color: #4fe3d4;
         font-weight: 600;
         background: rgba(79, 227, 212, 0.1);
      }

      .sat-center-viewport {
         position: relative;
         background: radial-gradient(circle at 50% 50%, #0b1e42 0%, #050e24 70%, #020614 100%);
         border: 1px solid rgba(79, 227, 212, 0.3);
         border-radius: 16px;
         overflow: hidden;
         display: flex;
         flex-direction: column;
      }

      #sat-3d-canvas {
         width: 100%;
         height: 100%;
         display: block;
      }

      .sat-viewport-overlay {
         position: absolute;
         inset: 0;
         pointer-events: none;
         display: flex;
         flex-direction: column;
         justify-content: space-between;
         padding: 12px;
      }

      .sat-turntable-hint {
         font-size: 0.72rem;
         color: #94a3b8;
         background: rgba(6, 14, 30, 0.75);
         padding: 4px 10px;
         border-radius: 8px;
         align-self: center;
         border: 1px solid rgba(255, 255, 255, 0.1);
      }

      .sat-mount-targets {
         position: absolute;
         inset: 0;
         pointer-events: none;
      }

      .sat-target-badge {
         position: absolute;
         pointer-events: auto;
         transform: translate(-50%, -50%);
         background: rgba(6, 18, 42, 0.9);
         border: 1.5px dashed rgba(79, 227, 212, 0.75);
         border-radius: 20px;
         padding: 5px 12px;
         color: #e2e8f0;
         font-size: 0.72rem;
         font-weight: 700;
         display: flex;
         align-items: center;
         gap: 6px;
         cursor: pointer;
         backdrop-filter: blur(8px);
         box-shadow: 0 0 15px rgba(0, 0, 0, 0.6), 0 0 8px rgba(79, 227, 212, 0.2);
         transition: border-color 0.18s, background 0.18s, transform 0.18s, box-shadow 0.18s;
         user-select: none;
         z-index: 10;
         white-space: nowrap;
      }

      .sat-target-badge:hover,
