               el.classList.add('tut-highlight');
            } else if (!PlayerState.trainingCompleted && tutStep === 1) {
               el.classList.remove('tut-highlight');
            } else {
               el.classList.remove('tut-highlight');
            }
         });
      }

      function navigateToLocation(locId) {
         const loc = LOCATIONS.find(l => l.id === locId);
         if (!loc) return;
         P.x = loc.target.x; P.z = loc.target.z; yaw = loc.yaw; pitch = 0;
         cam.position.set(P.x, 1.7, P.z);
         say(`Navigated to ${loc.name}`);
         closeMap();
         if (!PlayerState.trainingCompleted && tutStep === 2 && locId === 'gsc') {
            say('Ground Station reached! Now find and click the antenna dish to complete Task 2.', 4000);
         }
