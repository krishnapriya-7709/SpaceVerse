         // 3. Antenna
         const antGroup = new T.Group();
         const mastMat = new T.MeshStandardMaterial({ color: 0xd1d5db, roughness: 0.2, metalness: 0.9 });
         const mast = new T.Mesh(new T.CylinderGeometry(0.05, 0.06, 0.5, 16), mastMat);
         mast.position.set(0, 1.2, 0); antGroup.add(mast);
         const dishG = new T.Group(); dishG.position.set(0, 1.45, 0); dishG.rotation.x = -0.3;
         dishG.add(new T.Mesh(new T.CylinderGeometry(0.68, 0.08, 0.22, 28, 1, true),
            new T.MeshStandardMaterial({ color: 0xf1f5f9, roughness: 0.25, metalness: 0.85, side: T.DoubleSide })));
         const feed = new T.Mesh(new T.CylinderGeometry(0.025, 0.025, 0.35, 12), mastMat);
         feed.position.y = 0.22; dishG.add(feed);
         const sub = new T.Mesh(new T.SphereGeometry(0.06, 12, 12),
            new T.MeshStandardMaterial({ color: 0xf59e0b, emissive: 0xf59e0b, emissiveIntensity: 0.5 }));
         sub.position.y = 0.38; dishG.add(sub);
         antGroup.add(dishG);
         antGroup.visible = false; satParts['antenna'] = antGroup; satModelGroup.add(antGroup);

         // 4. Camera
         const camGroup = new T.Group();
         const barrelMat = new T.MeshStandardMaterial({ color: 0x0f172a, roughness: 0.3, metalness: 0.85 });
         const barrel = new T.Mesh(new T.CylinderGeometry(0.32, 0.38, 0.65, 24), barrelMat);
         barrel.position.set(0, -1.25, 0); camGroup.add(barrel);
         const shroud = new T.Mesh(new T.CylinderGeometry(0.4, 0.4, 0.35, 24, 1, true),
            new T.MeshStandardMaterial({ color: 0xf59e0b, roughness: 0.3, metalness: 0.85 }));
         shroud.position.set(0, -1.15, 0); camGroup.add(shroud);
         const lens = new T.Mesh(new T.SphereGeometry(0.28, 20, 20, 0, Math.PI * 2, 0, Math.PI / 3),
            new T.MeshStandardMaterial({ color: 0x0284c7, roughness: 0.05, metalness: 0.95, emissive: 0x0369a1, emissiveIntensity: 0.3 }));
         lens.rotation.x = Math.PI; lens.position.set(0, -1.54, 0); camGroup.add(lens);
         camGroup.visible = false; satParts['camera'] = camGroup; satModelGroup.add(camGroup);

         // 5. Computer
         const compGroup = new T.Group();
         const compH = new T.Mesh(new T.BoxGeometry(0.42, 0.38, 0.28),
            new T.MeshStandardMaterial({ color: 0x475569, roughness: 0.3, metalness: 0.85 }));
         compH.position.set(-0.55, 0.35, 0.72); compGroup.add(compH);
         const d1 = new T.Mesh(new T.SphereGeometry(0.025, 8, 8),
            new T.MeshStandardMaterial({ color: 0x38bdf8, emissive: 0x38bdf8, emissiveIntensity: 0.9 }));
         d1.position.set(-0.62, 0.38, 0.87); compGroup.add(d1);
         compGroup.visible = false; satParts['computer'] = compGroup; satModelGroup.add(compGroup);

         // 6. ADCS
         const adcsGroup = new T.Group();
         const cage = new T.Mesh(new T.BoxGeometry(0.48, 0.44, 0.28),
            new T.MeshStandardMaterial({ color: 0x64748b, roughness: 0.3, metalness: 0.8 }));
         cage.position.set(0.55, -0.3, 0.72); adcsGroup.add(cage);
         const wheelMat = new T.MeshStandardMaterial({ color: 0xb45309, roughness: 0.25, metalness: 0.9 });
         [[0.46, -0.3, Math.PI / 2], [0.62, -0.22, 0], [0.58, -0.38, Math.PI / 2]].forEach(([x, y, rx], i) => {
            const w = new T.Mesh(new T.CylinderGeometry(0.12, 0.12, 0.04, 16), wheelMat);
            w.rotation.x = rx; w.position.set(x, y, 0.82); adcsGroup.add(w);
         });
         adcsGroup.visible = false; satParts['adcs'] = adcsGroup; satModelGroup.add(adcsGroup);

         // 7. Propulsion
         const propGroup = new T.Group();
         const tankMat = new T.MeshStandardMaterial({ color: 0x94a3b8, roughness: 0.25, metalness: 0.95 });
         const t1 = new T.Mesh(new T.SphereGeometry(0.26, 16, 16), tankMat); t1.position.set(-0.35, 0.95, -0.76); propGroup.add(t1);
         const t2 = new T.Mesh(new T.SphereGeometry(0.26, 16, 16), tankMat); t2.position.set(0.35, 0.95, -0.76); propGroup.add(t2);
         const nozzleMat = new T.MeshStandardMaterial({ color: 0x334155, roughness: 0.3, metalness: 0.9 });
         [[-0.22, 0.55], [0.22, 0.55], [-0.22, 0.2], [0.22, 0.2]].forEach(([nx, ny]) => {
            const c = new T.Mesh(new T.ConeGeometry(0.09, 0.22, 16, 1, true), nozzleMat);
            c.rotation.x = -Math.PI / 2; c.position.set(nx, ny, -0.84); propGroup.add(c);
         });
         propGroup.visible = false; satParts['propulsion'] = propGroup; satModelGroup.add(propGroup);
      }

      function renderSatWorkspace() {
         renderSatComponentsList();
         renderSatChecklist();
         renderSatMountTargets();
         updateSatProgressUI();
      }

      function renderSatComponentsList() {
         const list = $('sat-comp-list-el'); if (!list) return;
         list.innerHTML = '';
         SAT_COMPONENTS.forEach(comp => {
            const isInstalled = satInstalledParts.has(comp.id);
            const isSelected = selectedCompId === comp.id;
            const card = document.createElement('div');
            card.id = `sat-card-${comp.id}`;
            card.className = `sat-comp-card ${isInstalled ? 'installed' : ''} ${isSelected ? 'selected' : ''}`;
            card.draggable = !isInstalled;
            card.innerHTML = `
               <div class="sat-comp-header">
                  <div class="sat-comp-title"><span>${comp.icon}</span><span>${comp.name}</span></div>
                  ${isInstalled
                  ? '<span style="font-size:0.7rem;color:#34d399;font-weight:700;">✓ Mounted</span>'
                  : `<button class="sat-mount-btn" onclick="quickMountComponent('${comp.id}')">Mount</button>`}
               </div>
               <div class="sat-comp-func">${comp.func}</div>`;
            if (!isInstalled) {
               card.onclick = e => { if (e.target.tagName === 'BUTTON') return; SFX.select(); selectComponentToMount(comp.id); };
               card.ondragstart = e => { e.dataTransfer.setData('text/plain', comp.id); SFX.select(); selectComponentToMount(comp.id); setSatFeedback(`Dragging: <b>${comp.name}</b> – ${comp.func}. Drop onto its target marker.`, 'neutral'); };
            }
            list.appendChild(card);
         });
      }

      function renderSatChecklist() {
         const cl = $('sat-checklist-el'); if (!cl) return;
         cl.innerHTML = '';
         SAT_COMPONENTS.forEach(comp => {
            const done = satInstalledParts.has(comp.id);
            const item = document.createElement('div');
            item.className = `sat-checklist-item ${done ? 'done' : ''}`;
            item.innerHTML = `<span>${comp.icon} ${comp.name}</span><span>${done ? '✓ READY' : '○ PENDING'}</span>`;
            cl.appendChild(item);
         });
      }

      function renderSatMountTargets() {
         const tc = $('sat-mount-targets'); if (!tc) return;
         tc.innerHTML = '';
         SAT_COMPONENTS.forEach(comp => {
            const isInstalled = satInstalledParts.has(comp.id);
            const badge = document.createElement('div');
            badge.id = `sat-target-${comp.id}`;
            badge.dataset.compId = comp.id;
            badge.className = `sat-target-badge ${isInstalled ? 'installed' : ''}`;
            badge.innerHTML = `<span>${isInstalled ? '✓' : '🎯'}</span><span>${comp.targetName}</span>`;
            badge.ondragover = e => { e.preventDefault(); if (!isInstalled) badge.classList.add('drag-over'); };
            badge.ondragleave = () => badge.classList.remove('drag-over');
            badge.ondrop = e => {
               e.preventDefault(); badge.classList.remove('drag-over');
               const did = e.dataTransfer.getData('text/plain');
               if (did === comp.id) installSatComponent(comp.id);
               else if (did) rejectSatComponent(did, comp.id);
            };
            badge.onclick = () => {
               if (isInstalled) return;
               if (!selectedCompId) { setSatFeedback(`Target: <b>${comp.targetName}</b>. Select the matching component from the right panel.`, 'neutral'); return; }
               if (selectedCompId === comp.id) installSatComponent(comp.id);
               else rejectSatComponent(selectedCompId, comp.id);
            };
            tc.appendChild(badge);
         });
      }

      function selectComponentToMount(compId) {
         if (satInstalledParts.has(compId)) return;
         selectedCompId = compId;
         const comp = SAT_COMPONENTS.find(c => c.id === compId);
         document.querySelectorAll('.sat-comp-card').forEach(el => el.classList.remove('selected'));
         const card = $(`sat-card-${compId}`); if (card) card.classList.add('selected');
         document.querySelectorAll('.sat-target-badge').forEach(el => el.classList.remove('highlight-needed'));
         const target = $(`sat-target-${compId}`); if (target) target.classList.add('highlight-needed');
         if (comp) setSatFeedback(`Selected: <b>${comp.name}</b> (${comp.func}). Drag or click the highlighted target <b>${comp.targetName}</b>.`, 'neutral');
      }

      window.quickMountComponent = function (compId) { installSatComponent(compId); };

      function installSatComponent(compId) {
         if (satInstalledParts.has(compId)) return;
         const comp = SAT_COMPONENTS.find(c => c.id === compId); if (!comp) return;
         satInstalledParts.add(compId);
         selectedCompId = null;
         if (satParts[compId]) {
            satParts[compId].visible = true;
            satParts[compId].scale.set(0.05, 0.05, 0.05);
            let s = 0.05;
            const pop = setInterval(() => { s += 0.15; if (s >= 1) { satParts[compId].scale.set(1, 1, 1); clearInterval(pop); } else satParts[compId].scale.set(s, s, s); }, 16);
         }
         SFX.snapCorrect();
         setSatFeedback(comp.correctNote, 'success');
         renderSatWorkspace();
         if (satInstalledParts.size === SAT_COMPONENTS.length) completeSatelliteAssembly();
      }

      function rejectSatComponent(draggedId, targetId) {
         const comp = SAT_COMPONENTS.find(c => c.id === draggedId);
         const targetComp = SAT_COMPONENTS.find(c => c.id === targetId);
         if (!comp) return;
         SFX.snapWrong();
         const card = $(`sat-card-${draggedId}`);
         if (card) { card.classList.add('sat-shake'); setTimeout(() => card.classList.remove('sat-shake'), 450); }
         const reason = comp.wrongNotes && comp.wrongNotes[targetId]
            ? comp.wrongNotes[targetId]
            : `Incorrect Position: ${comp.name} belongs at ${comp.targetName}, not ${targetComp ? targetComp.targetName : 'this position'}.`;
         setSatFeedback(reason, 'error');
      }

      function setSatFeedback(text, type = 'neutral') {
         const box = $('sat-feedback-box'); if (!box) return;
         box.className = `sat-feedback-box sat-feedback-${type}`;
         box.innerHTML = text;
      }

      function updateSatProgressUI() {
         const count = satInstalledParts.size, total = SAT_COMPONENTS.length;
         $('sat-prog-count').textContent = `${count}/${total}`;
         $('sat-prog-fill').style.width = `${(count / total) * 100}%`;
         $('sat-star-credits').textContent = PlayerState.starCredits.toLocaleString();
      }

      function completeSatelliteAssembly() {
         SFX.levelComplete();
         satLabSpinning = true;
         setSatFeedback('★ <b>SATELLITE ASSEMBLY SUCCESSFUL!</b> All 7 subsystems installed and nominal. Power, comms, avionics, and optics online.', 'success');
         const isFirstTime = !PlayerState.completedLevels.includes(1);
         if (isFirstTime) {
            PlayerState.starCredits += 100;
            PlayerState.completedLevels.push(1);
            PlayerState.levelScores[1] = 100;
            if (!PlayerState.badges.includes('SATELLITE_BUILDER')) PlayerState.badges.push('SATELLITE_BUILDER');
            PlayerState.currentCampaignLevel = Math.max(PlayerState.currentCampaignLevel, 2);
            savePlayerData();
         }
         $('sat-builder-badge-slot').innerHTML = createSatelliteBuilderBadgeSVG(160);
         $('sat-star-credits').textContent = PlayerState.starCredits.toLocaleString();
         setTimeout(() => {
            SFX.badgeUnlock();
            $('sat-success-modal').style.display = 'grid';
         }, 1200);
      }

      function updateSatTargetCoords() {
         const canvas = $('sat-3d-canvas');
         if (!canvas || !satLabCamera || !satModelGroup) return;
         const rect = canvas.getBoundingClientRect();
         const w = rect.width, h = rect.height;
         if (w <= 0 || h <= 0) return;
         SAT_COMPONENTS.forEach(comp => {
            const badge = $(`sat-target-${comp.id}`); if (!badge) return;
            const v = new T.Vector3(comp.anchorPos.x, comp.anchorPos.y, comp.anchorPos.z);
            v.applyEuler(satModelGroup.rotation);
            v.add(satModelGroup.position);
            v.project(satLabCamera);
            badge.style.left = `${(v.x * 0.5 + 0.5) * w}px`;
            badge.style.top = `${(-(v.y * 0.5) + 0.5) * h}px`;
            badge.style.display = v.z > 1.0 ? 'none' : 'flex';
         });
      }

      function satLabLoop() {
         if (!satLabActive) return;
         satRotation.y += satLabSpinning ? 0.012 : (satDragState.dragging ? 0 : 0.002);
         if (satModelGroup) { satModelGroup.rotation.y = satRotation.y; satModelGroup.rotation.x = satRotation.x; }
         updateSatTargetCoords();
         if (satLabRenderer && satLabScene && satLabCamera) satLabRenderer.render(satLabScene, satLabCamera);
         requestAnimationFrame(satLabLoop);
      }

      function openSatelliteAssemblyLab() { $('sat-intro-modal').style.display = 'grid'; }

      function startSatelliteAssemblyLab() {
         $('sat-intro-modal').style.display = 'none';
         $('sat-assembly-lab').style.display = 'flex';
         satLabActive = true; satLabSpinning = false;
         if (!satLabRenderer) initSatLab3D(); else resizeSatRenderer();
         renderSatWorkspace();
         setSatFeedback('Select or drag a component from the right panel and mount it on the satellite chassis.', 'neutral');
         requestAnimationFrame(satLabLoop);
      }

      function closeSatelliteAssemblyLab() {
         satLabActive = false; satLabSpinning = false;
         $('sat-assembly-lab').style.display = 'none';
         $('sat-success-modal').style.display = 'none';
         $('sat-intro-modal').style.display = 'none';
      }

      $('start-sat-assembly-btn').onclick = startSatelliteAssemblyLab;
      $('sat-exit-btn').onclick = closeSatelliteAssemblyLab;
      $('sat-complete-continue-btn').onclick = () => {
         closeSatelliteAssemblyLab();
         openCampaignModal();
         say('Level 1 Complete! Earth Observation Satellite operational. Level 2 Unlocked!', 5000);
      };

      /* ========================================================
         WIRE SOUND EFFECTS TO EXISTING GAME EVENTS
         ======================================================== */
      // Navigation sound when player fast-travels to a location
      const _origNavigateToLocation = navigateToLocation;
      navigateToLocation = function (locId) {
         SFX.navigate();
         _origNavigateToLocation(locId);
      };

      // Task completion sound
      const _origCompleteTutTask = completeTutTask;
      completeTutTask = function (taskNum) {
         _origCompleteTutTask(taskNum);
         // After real completion runs, play sound
         setTimeout(() => SFX.taskComplete(), 100);
      };

      // Badge unlock sound when badge modal appears
      const _origBadgeModal = $('badge-claim-btn');
      if (_origBadgeModal) {
         const origOnclick = _origBadgeModal.onclick;
         _origBadgeModal.onclick = function () {
            SFX.click();
            if (origOnclick) origOnclick.call(this);
         };
      }

      // Badge awarded: play sound when badge modal is opened
      const _origWelcomeBtn = $('accept-btn');
      if (_origWelcomeBtn) {
         const origAO = _origWelcomeBtn.onclick;
         _origWelcomeBtn.onclick = function () {
            SFX.click();
            if (origAO) origAO.call(this);
         };
      }

      // Sound when badge modal shows (recruitment badge awarded)
      (function () {
         const badgeModal = $('badge-modal');
         if (badgeModal) {
            const observer = new MutationObserver(mutations => {
               mutations.forEach(m => {
                  if (m.type === 'attributes' && m.attributeName === 'style') {
                     if (badgeModal.style.display === 'grid') SFX.badgeUnlock();
                  }
               });
            });
            observer.observe(badgeModal, { attributes: true });
         }
         const satSuccessModal = $('sat-success-modal');
         if (satSuccessModal) {
            const observer2 = new MutationObserver(mutations => {
               mutations.forEach(m => {
                  if (m.type === 'attributes' && m.attributeName === 'style') {
                     if (satSuccessModal.style.display === 'grid') SFX.levelComplete();
                  }
               });
            });
            observer2.observe(satSuccessModal, { attributes: true });
         }
      })();


      paint();
      ui();
      updateCurrencyUI();
      requestAnimationFrame(loop);
   </script>
</body>

