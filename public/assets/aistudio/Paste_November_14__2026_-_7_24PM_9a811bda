      function openMap() {
         mapExpanded = true;
         $('map-modal').style.display = 'grid';
         updateExpandedListActive();
         drawMap(ectx, expCanvas.width, expCanvas.height, true);
         if (!PlayerState.trainingCompleted && tutStep === 1) {
