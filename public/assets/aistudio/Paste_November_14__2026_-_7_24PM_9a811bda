      /* ========================================================
         INTERACTIVE FACILITY MAP CONTROLS & RENDERING
         ======================================================== */
      const miniCanvas = $('mini-canvas');
      const mctx = miniCanvas.getContext('2d');
      const expCanvas = $('exp-canvas');
      const ectx = expCanvas.getContext('2d');
      let mapExpanded = false;

      function worldToMap(wx, wz, w, h) {
         const nx = (wx - (-54)) / 108;
         const ny = (wz - (-38)) / 60;
         return { x: nx * w, y: ny * h };
      }

      function mapToWorld(mx, my, w, h) {
         const wx = (mx / w) * 108 + (-54);
         const wz = (my / h) * 60 + (-38);
         return { x: wx, z: wz };
      }

      function drawMap(ctx, width, height, isDetailed = false) {
         ctx.fillStyle = '#050b18';
         ctx.fillRect(0, 0, width, height);

         const c1 = worldToMap(-46, -6, width, height);
         const c2 = worldToMap(46, 2, width, height);
         ctx.fillStyle = 'rgba(79, 227, 212, 0.08)';
         ctx.fillRect(c1.x, c1.y, c2.x - c1.x, c2.y - c1.y);
         ctx.strokeStyle = 'rgba(79, 227, 212, 0.25)';
         ctx.lineWidth = 1;
         ctx.strokeRect(c1.x, c1.y, c2.x - c1.x, c2.y - c1.y);

         const curLoc = getCurrentLocation(P.x, P.z);
         LOCATIONS.forEach(loc => {
            const p1 = worldToMap(loc.bounds.x1, loc.bounds.z1, width, height);
            const p2 = worldToMap(loc.bounds.x2, loc.bounds.z2, width, height);
            const rw = p2.x - p1.x;
            const rh = p2.y - p1.y;

            const isCurrent = curLoc.id === loc.id;
            ctx.fillStyle = isCurrent ? 'rgba(79, 227, 212, 0.22)' : 'rgba(255, 255, 255, 0.04)';
            ctx.fillRect(p1.x, p1.y, rw, rh);

            ctx.strokeStyle = isCurrent ? loc.badgeColor : 'rgba(255, 255, 255, 0.18)';
            ctx.lineWidth = isCurrent ? 2 : 1;
            ctx.strokeRect(p1.x, p1.y, rw, rh);

            ctx.fillStyle = loc.badgeColor;
            ctx.font = isDetailed ? 'bold 11px system-ui' : 'bold 9px system-ui';
            ctx.textAlign = 'center';
            ctx.fillText(loc.code, p1.x + rw / 2, p1.y + rh / 2 + (isDetailed ? 0 : 3));

            if (isDetailed) {
               ctx.fillStyle = '#cbd5e1';
               ctx.font = '9px system-ui';
               ctx.fillText(loc.name.replace('Scientific Research ', '').replace('Spacecraft ', '').replace('NASA Space Center ', ''), p1.x + rw / 2, p1.y + rh / 2 + 13);
            }
         });

         const pCoord = worldToMap(P.x, P.z, width, height);
         const pulse = (Math.sin(performance.now() / 200) + 1) * 2;
         ctx.strokeStyle = 'rgba(79, 227, 212, 0.5)';
         ctx.lineWidth = 1.5;
         ctx.beginPath();
         ctx.arc(pCoord.x, pCoord.y, 6 + pulse, 0, Math.PI * 2);
         ctx.stroke();

         ctx.fillStyle = '#4fe3d4';
         ctx.beginPath();
         ctx.arc(pCoord.x, pCoord.y, 3.5, 0, Math.PI * 2);
         ctx.fill();
      }

      function renderFacilityMaps() {
         drawMap(mctx, miniCanvas.width, miniCanvas.height, false);
         if (mapExpanded) drawMap(ectx, expCanvas.width, expCanvas.height, true);
         const cur = getCurrentLocation(P.x, P.z);
         $('loc-name-txt').textContent = cur.name;
         $('loc-name-txt').style.color = cur.badgeColor;
      }

      const locListEl = $('loc-list-el');
      LOCATIONS.forEach(loc => {
         const item = document.createElement('div');
         item.className = 'loc-item';
         item.id = `item-${loc.id}`;
