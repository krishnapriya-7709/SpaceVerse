            navigate: () => {
               const ctx = getCtx();
               if (!ctx || _muted) return;
               const t = ctx.currentTime;
               const osc = ctx.createOscillator();
               const gain = ctx.createGain();
               osc.type = 'sine';
               osc.frequency.setValueAtTime(300, t);
               osc.frequency.exponentialRampToValueAtTime(80, t + 0.22);
