         function typeSub() {
            welcomeSubEl.appendChild(subCaret);
            function stepSub() {
               if (j < subText.length) {
                  welcomeSubEl.insertBefore(document.createTextNode(subText.charAt(j)), subCaret);
                  j++;
                  typeTimer2 = setTimeout(stepSub, 14);
               } else {
                  isTyping = false;
               }
            }
            stepSub();
         }
         typeMain();
      }

