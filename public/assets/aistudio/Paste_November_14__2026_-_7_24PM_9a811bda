      const satPanelR = new T.Mesh(new T.BoxGeometry(3.2, 1.2, 0.1), new T.MeshStandardMaterial({ color: 0x1e3a8a, roughness: 0.2 }));
      satPanelR.position.x = 2.8;
      satGroup.add(satBody, satPanelL, satPanelR);
      satGroup.position.set(22, 2.2, -6);
      sc.add(satGroup);
      mk(new T.CylinderGeometry(1.2, 1.4, 1.2, 16), 0x334155, 22, 0.6, -6);
      SOL.push({ x: 22, z: -6, r: 2.2 });

      const ring = new T.Mesh(new T.TorusGeometry(6, 0.15, 8, 64), new T.MeshBasicMaterial({ color: 0xf2c14e }));
      ring.rotation.x = Math.PI / 2; ring.position.set(36, 10, -12); ring.visible = false; sc.add(ring);
      lab('SPACECRAFT ASSEMBLY HANGAR', 24, 9, -34, 14, '#fbbf24');

      /* SECTOR 6: MISSION PLANNING ROOM */
      mk(new T.CylinderGeometry(3.5, 4, 1.2, 32), 0x222d3f, -28, 0.6, 10);
      SOL.push({ x: -28, z: 10, r: 4.5 });
      const holoSphere = new T.Mesh(new T.SphereGeometry(1.6, 24, 16), new T.MeshBasicMaterial({ color: 0x818cf8, wireframe: true, transparent: true, opacity: 0.65 }));
      holoSphere.position.set(-28, 2.6, 10); sc.add(holoSphere);
      const holoOrbit = new T.Mesh(new T.TorusGeometry(2.5, 0.04, 8, 48), new T.MeshBasicMaterial({ color: 0x4fe3d4 }));
      holoOrbit.rotation.x = 1.1; holoOrbit.rotation.y = 0.4; holoOrbit.position.set(-28, 2.6, 10); sc.add(holoOrbit);
      lab('MISSION PLANNING ROOM', -28, 8, 20.8, 12, '#818cf8');

      /* SECTOR 7: LAUNCH CONTROL COMPLEX */
      mk(new T.BoxGeometry(24, 14, 1.5), 0x1d2636, 24, 7, -2);
      const winGlass = mk(new T.PlaneGeometry(16, 5), 0x4fe3d4, 24, 4.5, -2.8);
      winGlass.material = new T.MeshLambertMaterial({ color: 0x5be3d4, transparent: true, opacity: 0.35 });
      mk(new T.BoxGeometry(4.5, 2, 1.8), 0x263040, 24, 1, 4);
      const cs = mk(new T.PlaneGeometry(3.6, 1.2), 0xf2c14e, 24, 1.8, 4.88);
      cs.rotation.y = Math.PI; cs.material = new T.MeshBasicMaterial({ color: 0xf2c14e });
      lab('LAUNCH CONTROL COMPLEX', 24, 6.8, 4.8, 9, '#f87171');
      SOL.push({ x: 24, z: 4, r: 2.8 });

      /* SUPPLY CRATES (INSTRUMENTS & MOTORS) */
      const CR = [
         { k: 't', n: 'Thermometer', m: 3, c: 5, cred: 500, x: -14 },
         { k: 'b', n: 'Barometer', m: 4, c: 8, cred: 800, x: -9 },
         { k: 'c', n: 'Camera', m: 8, c: 15, cred: 1500, x: -4 },
         { k: 's', n: 'Spark-S', imp: 600, c: 20, cred: 2000, x: 8 },
         { k: 'm', n: 'Ridge-M', imp: 1500, c: 45, cred: 4500, x: 14 },
         { k: 'x', n: 'Crest-X', imp: 2200, c: 65, cred: 6500, x: 20 },
         { k: 'l', n: 'Titan-L', imp: 3000, c: 90, cred: 9000, x: 26 }
      ];

      CR.forEach(c => {
         c.mot = !!c.imp;
         c.mesh = mk(c.mot ? new T.BoxGeometry(2.4, 3.2, 2.4) : new T.BoxGeometry(2, 2, 2), c.mot ? 0xb4663a : 0x3a78b4, c.x, c.mot ? 1.6 : 1, -25);
         mk(new T.BoxGeometry(c.mot ? 2.8 : 2.4, 0.4, c.mot ? 2.8 : 2.4), 0x242d3d, c.x, 0.2, -25);
         lab(c.mot ? `${c.n}  ${c.imp} thrust  ₡${c.cred}` : `${c.n}  ${c.m} kg  ₡${c.cred}`, c.x, c.mot ? 4.8 : 3.4, -25, 6);
         SOL.push({ x: c.x, z: -25, r: 1.6 });
         INT.push({
            x: c.x, z: -25, r: 4.2,
            text: () => S.phase === 1 ? (sel(c) ? 'Press E: put back ' : 'Press E: take ') + c.n : null,
            act: () => take(c)
         });
      });

      /* ========================================================
         GAMEPLAY STATE & MECHANICS
         ======================================================== */
      const S = { n: 0, phase: 0, items: new Set(), mot: null, flying: false, score: 0, hide: 0, t0: 0, r: null };
      const nm = k => {
         if (!k) return '';
         const found = CR.find(c => c.k === k);
         if (found) return found.n;
         if (k === 't') return 'Thermometer';
         if (k === 'b') return 'Barometer';
         if (k === 'c') return 'Camera';
         if (k === 'm1') return 'Small Solid Motor';
         if (k === 'm2') return 'Medium Solid Motor';
         if (k === 'm3') return 'Large Solid Motor';
         return k;
      };
      const sel = c => c.mot ? S.mot === c.k : S.items.has(c.k);

      function getCurrentMission() {
         return CAMPAIGN_LEVELS[S.n] || CAMPAIGN_LEVELS[0];
      }

      function calc() {
         const p = [...S.items].map(k => CR.find(c => c.k === k));
         const m = CR.find(c => c.k === S.mot);
         const mass = 20 + p.reduce((a, x) => a + x.m, 0);
         const cost = p.reduce((a, x) => a + x.c, 0) + (m ? m.c : 0);
         return { p, m, mass, cost, alt: m ? 1.5 * m.imp / mass : 0 };
      }

      function say(t, ms = 3500) {
         const e = $('msg'); e.textContent = t; e.style.opacity = 1; S.hide = performance.now() + ms;
      }

      function paint() {
         CR.forEach(c => c.mesh.material.color.setHex(sel(c) ? 0x39d98a : c.mot ? 0xb4663a : 0x3a78b4));
      }

      function ui() {
         const manEl = $('man');
         if (!manEl) return;

         if (!PlayerState.trainingCompleted && tutStep > 0) {
            manEl.style.display = 'none';
            return;
         }

         const curLoc = getCurrentLocation(P.x, P.z);
         const inStagingSector = (curLoc.id === 'sah' || curLoc.id === 'srl' || curLoc.id === 'lcc' || S.items.size > 0 || S.mot !== null);

         if (!inStagingSector) {
            manEl.style.display = 'none';
            return;
         }

         manEl.style.display = 'block';
         const r = calc(), M = getCurrentMission();
         const isOverBudget = r.cost > M.b;

         manEl.innerHTML = `
            <div class="man-title">
               <span>🚀 Rocket Manifest</span>
               <span style="color:${isOverBudget ? '#f87171' : '#34d399'};font-size:0.68rem;">${isOverBudget ? 'OVER BUDGET' : 'NOMINAL'}</span>
            </div>
            <div class="man-row"><span>Vehicle Dry Mass:</span><b>${r.mass} kg</b></div>
            <div class="man-row"><span>Staging Cost:</span><b style="color:${isOverBudget ? '#f87171' : '#4fe3d4'};">${r.cost}M / ${M.b}M</b></div>
            <div class="man-row"><span>Predicted Apogee:</span><b>${r.m ? r.alt.toFixed(0) + ' km' : '(No Motor)'}</b></div>
            <div class="man-row"><span>Flight Score:</span><b style="color:#ffd700;">${S.score} pts</b></div>
         `;
      }

      function obj() {
         if (!PlayerState.trainingCompleted && tutStep > 0) {
            // Training phase active: hide obj and man boxes so screen is clean!
            ring.visible = false;
            $('obj').style.display = 'none';
            $('man').style.display = 'none';
            updateTrainingHUD();
            return;
         }

         // Campaign Phase: independent gameplay
         $('obj').style.display = 'block';
         const M = getCurrentMission(), P = S.phase;
         ring.visible = P === 1 || P === 2;
         ring.position.y = (typeof M.t === 'number') ? M.t * 1.2 : 40;

         const o = [
            [`Level 0${M.lvl}: ${M.title}`, 'Report to Mission Control Center (MCC) and press E to receive your mission briefing.'],
            [`Level 0${M.lvl}: ${M.title}`, `Target: ${typeof M.t === 'number' ? M.t + ' km' : M.t} | Budget: ${M.b}M. Requisites: ${M.req.map(nm).join(', ')}. Select instruments at Research Lab, configure motor at Assembly Hangar, and load pad.`],
            ['Rocket Ready on Launch Pad', 'Proceed to the Launch Control Complex (LCC) console and press E to begin countdown.'],
            ['Mission Flight Complete', 'Return to Mission Control Center for orbital debriefing and certification rewards.']
         ][P];

         $('obj').innerHTML = `
            <div class="obj-header">
               <div class="obj-header-title">
                  <span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:#4fe3d4;box-shadow:0 0 6px #4fe3d4;"></span>
                  <span>MISSION DIRECTIVE</span>
               </div>
               <span style="font-size:0.68rem;color:var(--accent);font-weight:700;">LEVEL 0${M.lvl}</span>
            </div>
            <div class="obj-body">
               <div class="obj-main-title">${o[0]}</div>
               <div class="obj-goal-txt">${o[1]}</div>
               <div class="obj-stat-row">
                  <div class="obj-stat-item">Target: <b>${typeof M.t === 'number' ? M.t + ' km' : M.t}</b></div>
                  <div class="obj-stat-item">Budget: <b>${M.b}M</b></div>
                  <div class="obj-stat-item">Req: <b>${M.req.map(nm).join(', ')}</b></div>
               </div>
            </div>
         `;
         ui();
      }

      function take(c) {
         if (!PlayerState.trainingCompleted && tutStep === 4) {
            // Trigger tutorial step 4 instrument inspection
            completeTutTask(4);
         }
         const isTaking = c.mot ? S.mot !== c.k : !S.items.has(c.k);
         if (isTaking) {
            if (PlayerState.grantCredits < c.cred) {
               return say(`Insufficient Grant Credits! Need ₡${c.cred.toLocaleString()} (Available: ₡${PlayerState.grantCredits.toLocaleString()})`, 4000);
            }
            PlayerState.grantCredits -= c.cred;
         } else {
            PlayerState.grantCredits += c.cred;
         }
         savePlayerData();
         if (c.mot) S.mot = S.mot === c.k ? null : c.k;
         else S.items.has(c.k) ? S.items.delete(c.k) : S.items.add(c.k);
         paint(); ui();
         say(sel(c) ? `${c.n} acquired (-₡${c.cred.toLocaleString()})` : `${c.n} returned (+₡${c.cred.toLocaleString()})`);
      }

      function load() {
         const M = getCurrentMission(), r = calc(), miss = M.req.filter(k => !S.items.has(k));
         if (miss.length) return say('Missing required: ' + miss.map(nm).join(', '));
         if (!S.mot) return say('Take a motor crate first.');
         if (r.cost > M.b) return say(`Over budget by $${r.cost - M.b}M. Put something back.`);
         S.phase = 2; rk.visible = true; rk.scale.set(1, { s: 0.8, m: 1, x: 1.2, l: 1.4 }[S.mot], 1);
         obj(); say('Rocket loaded on pad. Proceed to Launch Control Complex.');
      }

      // Mission Control Trigger
      INT.push({
         x: -34, z: -20, r: 12,
         text: () => {
            if (!PlayerState.trainingCompleted) {
               return tutStep === 5 ? 'Press E: Inspect Mission Monitoring Screens' : null;
            }
            return S.phase === 0 ? 'Press E: get mission briefing' : S.phase === 3 ? 'Press E: debrief & advance level' : null;
         },
         act: () => {
            if (!PlayerState.trainingCompleted) {
               if (tutStep === 5) completeTutTask(5);
               return;
            }
            if (S.phase === 0) {
               S.phase = 1; obj(); say('Briefing received. Check the objective panel.');
            } else {
               // Debrief and unlock next campaign level
               const completedLvl = S.n + 1;
               if (!PlayerState.completedLevels.includes(completedLvl)) {
                  PlayerState.completedLevels.push(completedLvl);
               }
               if (S.n < CAMPAIGN_LEVELS.length - 1) {
                  S.n++;
                  PlayerState.currentCampaignLevel = S.n + 1;
               }
               S.items.clear(); S.mot = null; paint(); S.phase = 0;
               savePlayerData(); obj();
               say(`Level ${completedLvl} Debrief complete! Next Level Ready.`, 5000);
            }
         }
      });

      // Rocket Pad Trigger
      INT.push({
         x: 36, z: -12, r: 12,
         text: () => S.phase === 1 ? 'Press E: load rocket with parts' : S.phase === 2 && !S.flying ? 'Press E: unload rocket' : null,
         act: () => {
            if (S.phase === 1) load();
            else { S.phase = 1; rk.visible = false; obj(); say('Rocket unloaded.'); }
         }
      });

      // Launch Console Trigger
      INT.push({
         x: 24, z: 4, r: 5.5,
         text: () => S.phase === 2 && !S.flying ? 'Press E: INITIATE LAUNCH' : null,
         act: () => {
            S.flying = true; S.t0 = performance.now(); S.r = calc(); $('man').style.opacity = 0.4;
         }
      });

      // Ground Station Antenna Trigger (Tutorial Task 2)
      INT.push({
         x: -38, z: 8, r: 6.5,
         text: () => (!PlayerState.trainingCompleted && tutStep === 2) ? 'Press E: Explore Communication Antenna' : 'Press E: Inspect Antenna Telemetry',
         act: () => {
            if (!PlayerState.trainingCompleted && tutStep === 2) completeTutTask(2);
            else say('Ground Station Telemetry Antenna: Uplink & Downlink nominal.');
         }
      });

      // Spacecraft Test Stand Trigger (Tutorial Task 3)
      INT.push({
         x: 22, z: -6, r: 5.5,
         text: () => (!PlayerState.trainingCompleted && tutStep === 3) ? 'Press E: Inspect Spacecraft Systems' : 'Press E: Inspect Spacecraft Architecture',
         act: () => {
            if (!PlayerState.trainingCompleted && tutStep === 3) completeTutTask(3);
            else showComponentExplorerModal();
         }
      });

      function flight(now) {
         const e = (now - S.t0) / 1000, r = S.r, M = getCurrentMission();
         if (e < 3) {
            say(String(Math.ceil(3 - e)), 400); fl.visible = e > 2.4;
         } else {
            const k = Math.min(1, (e - 3) / 4.5);
            const a = r.alt * (1 - Math.pow(1 - k, 3));
            rk.position.y = 0.4 + a * 1.2; fl.visible = k < 1;
            say(a.toFixed(0) + ' km', 400); cam.lookAt(36, rk.position.y + 5, -12);
            if (k >= 1) {
               S.flying = false; fl.visible = false; $('man').style.opacity = 1;
               const ok = r.alt >= M.t, ex = r.p.filter(x => !M.req.includes(x.k)).length, left = Math.max(0, M.b - r.cost);
               if (ok) {
                  const sc2 = 100 + ex * 25 + left * 2;
                  const earnGrant = 2500 + sc2 * 10;
                  const earnStar = 20;
                  S.score += sc2;
                  PlayerState.grantCredits += earnGrant;
                  PlayerState.starCredits += earnStar;
                  PlayerState.levelScores[M.lvl] = Math.max(PlayerState.levelScores[M.lvl] || 0, sc2);
                  savePlayerData();
                  S.phase = 3;
                  say(`Mission Success! ${r.alt.toFixed(0)} km reached. +${sc2} pts (+₡${earnGrant.toLocaleString()}, +★${earnStar})`, 6000);
               } else {
                  S.phase = 1;
                  say(`Fell short: ${r.alt.toFixed(0)} km of ${M.t} km. Thrust insufficient for vehicle mass. Adjust payload and retry.`, 7000);
               }
               setTimeout(() => { rk.position.y = 0.4; rk.visible = false; obj(); }, 3500); obj();
            }
         }
      }

      /* ========================================================
         MANDATORY INTERACTIVE TRAINING TUTORIAL SYSTEM (TASKS 1-6)
         ======================================================== */
      let tutStep = 0; // 0: not started, 1..6: active task

      function startCadetTraining() {
         tutStep = 1;
         $('tut-progress-hud').style.display = 'block';
         updateTrainingHUD();
         say('Tutorial Started: Follow the highlighted objectives!', 4000);
      }

      function updateTrainingHUD() {
         if (PlayerState.trainingCompleted) {
            $('tut-progress-hud').style.display = 'none';
            tutBeacon.visible = false;
            removeHighlights();
            return;
         }

         $('tut-progress-hud').style.display = 'block';
         const completedCount = Math.max(0, tutStep - 1);
         $('tut-prog-counter').textContent = `PROGRESS: ${completedCount}/6`;
         $('tut-bar-fill').style.width = `${(completedCount / 6) * 100}%`;

         removeHighlights();
         tutBeacon.visible = false;

         if (tutStep === 1) {
            $('tut-instr-txt').textContent = 'TASK 1: Click the facility map in the top-right corner to open directory.';
            $('tut-subhint-txt').textContent = 'Click the map widget or press M key to expand.';
            $('map-card').classList.add('tut-highlight');
         } else if (tutStep === 2) {
            $('tut-instr-txt').textContent = 'TASK 2: Navigate to the Ground Station and explore the communication antenna.';
            $('tut-subhint-txt').textContent = 'Open the map (M), click Ground Station, then click the antenna dish or press E.';
            tutBeacon.position.set(-40, 5.5, 10);
            tutBeacon.visible = true;
         } else if (tutStep === 3) {
            $('tut-instr-txt').textContent = 'TASK 3: Navigate to Assembly Hangar and inspect the test spacecraft.';
            $('tut-subhint-txt').textContent = 'Use map to fast-navigate to SAH, then click the spacecraft.';
            tutBeacon.position.set(22, 4.5, -6);
            tutBeacon.visible = true;
         } else if (tutStep === 4) {
            $('tut-instr-txt').textContent = 'TASK 4: Navigate to Research Lab and click an instrument crate.';
            $('tut-subhint-txt').textContent = 'Inspect the Thermometer, Barometer, or Camera in SRL cleanroom.';
            tutBeacon.position.set(-9, 4.2, -25);
            tutBeacon.visible = true;
         } else if (tutStep === 5) {
            $('tut-instr-txt').textContent = 'TASK 5: Visit Mission Control and inspect the telemetry monitoring screens.';
            $('tut-subhint-txt').textContent = 'Walk up to Mission Control wall screens and press E or click screen.';
            tutBeacon.position.set(-34, 5.5, -24);
            tutBeacon.visible = true;
         } else if (tutStep === 6) {
            $('tut-instr-txt').textContent = 'TASK 6: Identify Grant Credits and Star Credits in your interface.';
            $('tut-subhint-txt').textContent = 'Click the currency counters or inspect the top status bar.';
            $('hud-currencies-el').classList.add('tut-highlight');
            $('man').classList.add('tut-highlight');
         }
      }

      function removeHighlights() {
         $('map-card').classList.remove('tut-highlight');
         $('hud-currencies-el').classList.remove('tut-highlight');
         $('man').classList.remove('tut-highlight');
         const gscItem = $('item-gsc'); if (gscItem) gscItem.classList.remove('tut-highlight');
      }

      function completeTutTask(taskNum) {
         if (tutStep !== taskNum) return;
         removeHighlights();
         tutBeacon.visible = false;

         const modal = $('tut-modal');
         const titleEl = $('tut-modal-title');
         const bodyEl = $('tut-modal-body');
         const continueBtn = $('tut-modal-continue-btn');

         if (taskNum === 1) {
            titleEl.textContent = 'Task 1 – Facility Map Opened ✓';
            bodyEl.innerHTML = `
               <p><strong>Well done!</strong> You've opened the GALAXY-X Facility Map directory. You can now navigate between all facility locations.</p>
               <div class="tut-bullets">
                  <b>Navigation Key Notes:</b>
                  <ul>
                     <li>Clicking the top-right minimap or pressing <kbd>M</kbd> opens the full facility floor plan.</li>
