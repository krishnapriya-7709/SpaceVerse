      let last = performance.now();
      function loop(now) {
         requestAnimationFrame(loop);
         const dt = Math.min(0.05, (now - last) / 1000);
         last = now;

         renderMCCScreen(now);
         holoSphere.rotation.y += 0.015;
         holoOrbit.rotation.z += 0.02;

         gantryHoist.position.z = -12 + Math.sin(now * 0.0006) * 5;
         craneArm.position.z = gantryHoist.position.z;
         hoistIndicator.position.z = gantryHoist.position.z;
         hoistIndicator.material.color.setHex((Math.sin(now * 0.005) > 0) ? 0x4fe3d4 : 0x0ea5e9);

         dish.rotation.z = Math.sin(now * 0.0004) * 0.15;
         dishGroup.rotation.y = Math.sin(now * 0.0003) * 0.25;
         satGroup.rotation.y += 0.008;
         hangarGlow.intensity = 0.7 + Math.sin(now * 0.003) * 0.3;

         // Animate 3D Waypoint Beacon during Tutorial
         if (tutBeacon.visible) {
            tutBeacon.position.y += Math.sin(now * 0.005) * 0.008;
            tutBeacon.rotation.y += 0.02;
         }

         const w = innerWidth, h = innerHeight;
         if (ren.domElement.width !== Math.floor(w * ren.getPixelRatio())) {
            ren.setSize(w, h, false);
            cam.aspect = w / h;
            cam.updateProjectionMatrix();
         }

         if (started && !S.flying) {
            let f = (keys.w || keys.arrowup ? 1 : 0) - (keys.s || keys.arrowdown ? 1 : 0) - jz;
            let r = (keys.d || keys.arrowright ? 1 : 0) - (keys.a || keys.arrowleft ? 1 : 0) + jx;
            const l = Math.hypot(f, r);
            if (l > 1) { f /= l; r /= l; }

            P.x += (-Math.sin(yaw) * f + Math.cos(yaw) * r) * 7.5 * dt;
            P.z += (-Math.cos(yaw) * f - Math.sin(yaw) * r) * 7.5 * dt;

            for (const o of SOL) {
               const dx = P.x - o.x, dz = P.z - o.z;
               const d = Math.hypot(dx, dz) || 0.01;
               if (d < o.r + 0.7) {
                  P.x = o.x + dx / d * (o.r + 0.7);
                  P.z = o.z + dz / d * (o.r + 0.7);
               }
            }

            P.x = Math.max(-53, Math.min(53, P.x));
            P.z = Math.max(-35, Math.min(19, P.z));

            cam.position.set(P.x, 1.7, P.z);
            cam.rotation.set(pitch, yaw, 0);
         } else if (!started) {
            const t = now * 0.00035;
            cam.position.set(Math.sin(t) * 16 - 4, 3.6 + Math.sin(t * 0.7) * 0.8, Math.cos(t) * 14 - 2);
            cam.lookAt(Math.sin(t + 0.5) * 6 + 6, 2.8, Math.cos(t + 0.5) * 8 - 14);
         }

         if (S.flying) flight(now);

         cur = null;
         let bd2 = 1e9, tx = '';
         if (started && !S.flying) {
            for (const o of INT) {
               const t = o.text();
               if (!t) continue;
               const d = Math.hypot(P.x - o.x, P.z - o.z);
               if (d < o.r && d < bd2) {
                  bd2 = d;
                  cur = o;
                  tx = t;
               }
            }
         }
         $('pr').textContent = tx;
         $('pr').style.opacity = cur ? 1 : 0;
         $('act').style.opacity = cur ? 1 : 0.3;

         if (now > S.hide) $('msg').style.opacity = 0;

         renderFacilityMaps();
         ren.render(sc, cam);
      }


