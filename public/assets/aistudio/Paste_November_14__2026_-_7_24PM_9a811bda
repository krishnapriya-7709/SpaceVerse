         }

         isTyping = true;
         let i = 0;
         const mainText = data.main, subText = data.sub;
         const caret = document.createElement('span');
         caret.className = 'typewriter-caret';
         caret.textContent = '▌';
         welcomeMainEl.appendChild(caret);

         function typeMain() {
            if (i < mainText.length) {
               welcomeMainEl.insertBefore(document.createTextNode(mainText.charAt(i)), caret);
