      function closeMap() {
         mapExpanded = false;
         $('map-modal').style.display = 'none';
      }

      $('map-card').onclick = openMap;
      $('map-close-btn').onclick = closeMap;
      $('map-modal').onclick = e => { if (e.target === $('map-modal')) closeMap(); };

      expCanvas.onclick = e => {
         const rect = expCanvas.getBoundingClientRect();
         const mx = (e.clientX - rect.left) * (expCanvas.width / rect.width);
         const my = (e.clientY - rect.top) * (expCanvas.height / rect.height);
         const w = mapToWorld(mx, my, expCanvas.width, expCanvas.height);
         const clickedLoc = getCurrentLocation(w.x, w.z);
         if (clickedLoc && clickedLoc.id !== 'corridor') {
            navigateToLocation(clickedLoc.id);
         } else {
            P.x = Math.max(-50, Math.min(48, w.x));
            P.z = Math.max(-32, Math.min(18, w.z));
            cam.position.set(P.x, 1.7, P.z);
            say(`Navigated to ${clickedLoc.name}`);
            closeMap();
         }
      };

      /* ========================================================
         PLAYER CONTROLS, RAYCASTING & CAMERA NAVIGATION
         ======================================================== */
      let yaw = Math.PI, pitch = 0, jx = 0, jz = 0, jid = null, lid = null, jo, lp, started = false, cur = null;
      const P = { x: -2, z: 12 }, keys = {};
      const cv = ren.domElement, joy = $('joy');

      // 3D Interactive Raycaster for clicking in-world objects
      const raycaster = new T.Raycaster();
      const mouse = new T.Vector2();

      cv.addEventListener('pointerdown', e => {
         if (mapExpanded || !started || $('tut-modal').style.display === 'grid' || $('campaign-modal').style.display === 'grid' || $('profile-modal').style.display === 'grid' || $('badge-modal').style.display === 'grid') return;
         cv.setPointerCapture(e.pointerId);
         if (e.pointerType === 'touch' && e.clientX < innerWidth * 0.45) {
            jid = e.pointerId; jo = [e.clientX, e.clientY];
            joy.style.cssText = `display:block;left:${e.clientX - 45}px;top:${e.clientY - 45}px`;
         } else {
            lid = e.pointerId; lp = [e.clientX, e.clientY];
         }
      });

      cv.addEventListener('pointermove', e => {
         if (mapExpanded || !started) return;
         if (e.pointerId === jid) {
            const dx = e.clientX - jo[0], dy = e.clientY - jo[1];
            const m = Math.min(1, Math.hypot(dx, dy) / 45), a = Math.atan2(dy, dx);
            jx = Math.cos(a) * m; jz = Math.sin(a) * m;
            joy.firstChild.style.transform = `translate(${jx * 30}px,${jz * 30}px)`;
         } else if (e.pointerId === lid) {
            yaw -= (e.clientX - lp[0]) * 0.005;
            pitch = Math.max(-1.3, Math.min(1.3, pitch - (e.clientY - lp[1]) * 0.005));
            lp = [e.clientX, e.clientY];
         }
      });

      const up = e => {
         if (e.pointerId === jid) { jid = null; jx = jz = 0; joy.style.display = 'none'; }
         if (e.pointerId === lid) {
            // Check if this was a quick click/tap on 3D objects
            if (lp && Math.hypot(e.clientX - lp[0], e.clientY - lp[1]) < 8) {
               mouse.x = (e.clientX / innerWidth) * 2 - 1;
               mouse.y = -(e.clientY / innerHeight) * 2 + 1;
               raycaster.setFromCamera(mouse, cam);
               handle3DObjectClick(raycaster);
            }
            lid = null;
         }
      };
      cv.addEventListener('pointerup', up);
      cv.addEventListener('pointercancel', up);

      function handle3DObjectClick(ray) {
         if (!started || S.flying) return;
         // Check Antenna
         if (ray.intersectObjects(dishGroup.children, true).length > 0) {
